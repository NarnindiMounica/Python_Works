    "#Factorial of a number with recursion\n",
    "\n",
    "def factorial_of_num(num):\n",
    "\n",
    "    if num==1 or 0:\n",
    "        return 1\n",
    "    else:\n",
    "        return num * factorial_of_num(num -1)\n",
    "    \n",
    "factorial_of_num(num = 5)    \n",
    "    "
